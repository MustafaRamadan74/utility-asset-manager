# ==========================================
# Database Configuration (PostgreSQL + PostGIS)
# ==========================================
# Host: 'localhost' when running backend locally outside Docker, 'db' inside Docker network
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=utility_assets

# ==========================================
# Backend Service Configuration
# ==========================================
# Port on which the NestJS backend runs (default is 3001 to avoid conflicting with frontend)
PORT=3001

# Allowed CORS origins (frontend origin)
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Frontend Configuration
# ==========================================
# Public API URL accessed by the client browser (must be reachable from the host machine)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
